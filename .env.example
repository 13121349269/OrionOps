# OrionOps 环境变量配置模板
# 生产环境请复制此文件为 .env 并修改所有密码和密钥

# MySQL
MYSQL_ROOT_PASSWORD=ChangeThisPassword123!

# Redis
REDIS_PASSWORD=ChangeThisRedisPassword456!

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=ChangeThisInfluxPassword789!
INFLUXDB_TOKEN=change-this-influxdb-token-to-a-long-random-string

# Vault AES 加密密钥 (必须为32字节Base64编码)
# 可使用以下命令生成: openssl rand -base64 32
VAULT_AES_KEY=ChangeThisToARandom32ByteBase64Key==
